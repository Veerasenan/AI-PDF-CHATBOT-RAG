# Runtime Generated Data
# (Created automatically when application runs)
# ======================================================

# Ignore everything inside these folders
data/chroma_db/*
data/uploaded_pdfs/*

# Keep the folders themselves
!data/chroma_db/.gitkeep
!data/uploaded_pdfs/.gitkeep

